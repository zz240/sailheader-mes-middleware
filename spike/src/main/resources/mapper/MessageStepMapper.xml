<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  消息步的自定义查询：按运行聚合出「消息数 / 消息步数 / 失败步数」（#130），
  以及一条运行的消息步索引（#131）。

  为什么落 XML 而不是注解散装：`summarizeByRunIds` 要遍历 runIds（<foreach>），注解里写不动；
  同一个实体的自定义 SQL 分两处放，读的人会以为口径不一样。列名与 DTO 字段名靠 MyBatis 的
  下划线转驼峰对上，改名字要两边一起改（对不上时是**空值**而不是报错，所以必须写死在一起）。
-->
<mapper namespace="com.example.edgegateway.mapper.MessageStepMapper">

    <!--
      口径（#130）：
        - step_count    这条运行下所有消息步（不分状态）
        - failed_steps  status = 'FAILED' 的那些（与消息步列表的 status=FAILED 同一口径）
        - message_count 消息数按 message_id 去重（一条消息穿过多个动作只算一条）
      没有任何消息步的运行**不出现在结果里**——那是「0 消息 0 步」，由服务层补默认值，
      而不是让这里编一行 0（编的话「查不到」与「真的是 0」就分不开了）。
    -->
    <select id="summarizeByRunIds" resultType="com.example.edgegateway.model.RunStepSummary">
        SELECT run_id,
               COUNT(*) AS step_count,
               SUM(CASE WHEN status = 'FAILED' THEN 1 ELSE 0 END) AS failed_steps,
               COUNT(DISTINCT message_id) AS message_count
        FROM message_step
        WHERE run_id IN
        <foreach collection="runIds" item="runId" open="(" separator="," close=")">
            #{runId}
        </foreach>
        GROUP BY run_id
    </select>

    <!--
      整条筛选集的**合计**（计数条那三个数，#130）：命中运行的判据下推成子查询，
      一次查询出总数，**不把命中运行的 id 拉回内存再拼 `IN`**——整库运行时那个 `IN` 是无界的
      （ADR-0016 结果 ⑥ 刚把 listRuns 那处同一个毛病收掉）。

      JOIN 而不是 `IN (SELECT run_id ...)`：MySQL 对 `IN (子查询)` 的优化不如 JOIN 稳。
      三个条件与运行列表的 matchingRuns 一一对应；`business_key LIKE` 那一格传的是
      `%关键词%`（与消息步检索那一侧的 like() 同一档语义：`%` / `_` 就是通配符，不做字面量转义）。
    -->
    <select id="summarizeMatchingRuns" resultType="com.example.edgegateway.model.RunStepTotals">
        SELECT COUNT(*) AS step_count,
               SUM(CASE WHEN s.status = 'FAILED' THEN 1 ELSE 0 END) AS failed_steps,
               COUNT(DISTINCT CONCAT(s.run_id, ':', s.message_id)) AS message_count
        FROM job_run r
        JOIN message_step s ON s.run_id = r.id
        <where>
            <if test="jobId != null">
                AND r.job_id = #{jobId}
            </if>
            <if test="status != null and status != ''">
                AND r.status = #{status}
            </if>
            <if test="businessKeyPattern != null and businessKeyPattern != ''">
                AND EXISTS (SELECT 1 FROM message_step k
                            WHERE k.run_id = r.id AND k.business_key LIKE #{businessKeyPattern})
            </if>
        </where>
    </select>

    <!--
      一条运行的**消息步索引**（#131）：右详情一次要这条运行的全部步，但**两个快照列一个都不取**。
      它们是 TEXT（单条上限 64 KB，#127），快照大小由目标端决定、本地拦不住——整行读回来就是让
      「点开一条运行」的价格由第三方响应体定价。这里只回画得出界面的那几列，快照落没落由两个布尔列
      回答（步骤链上那两个小点就是这个信息），要看快照本身再按 id 单独取整行（#132）。

      空白算没落（TRIM）：界面上那两个点的判据是「有没有可用内容」，与写库时的口径一致
      （`toJson` 不会写空白，但老数据 / 手工改过的行可能有）。

      ORDER BY id：这是一条运行的**步骤顺序**。运行列表与消息步检索那边的 `ORDER BY id DESC`
      是检索面的口径（最新在上），别把两边对齐——右详情的步骤链要从入口往后读。
    -->
    <select id="pageRunStepIndex" resultType="com.example.edgegateway.model.MessageStepIndex">
        SELECT id,
               run_id,
               message_id,
               step,
               action_name,
               status,
               error,
               created_at,
               attempt,
               duration_ms,
               business_key,
               CASE WHEN input_snapshot IS NOT NULL AND TRIM(input_snapshot) &lt;&gt; '' THEN 1 ELSE 0 END AS has_input_snapshot,
               CASE WHEN data_snapshot IS NOT NULL AND TRIM(data_snapshot) &lt;&gt; '' THEN 1 ELSE 0 END AS has_data_snapshot
        FROM message_step
        WHERE run_id = #{runId}
        ORDER BY id
    </select>

</mapper>
