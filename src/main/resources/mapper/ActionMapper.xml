    </sql>

    <update id="updateAction" parameterType="com.sailheader.middleware.model.Action">
        update "action_stream"
        set "job_id"          = #{jobId,jdbcType=BIGINT},
            "name"            = #{name,jdbcType=VARCHAR},
            type              = #{type,jdbcType=SMALLINT},
            status            = #{status,jdbcType=SMALLINT},
            index             = #{index,jdbcType=INTEGER},
            consume_data_type = #{consumeDataType,jdbcType=INTEGER},
            addition          = #{addition,typeHandler=com.sailheader.middleware.common.helper.JsonTypeHandlerPg},
            modified_by       = #{modifiedBy,jdbcType=INTEGER}
        where id = #{id,jdbcType=BIGINT}
    </update>

    <update id="updateByActionSelective" parameterType="com.sailheader.middleware.model.Action">
        update "action_stream"
        <set>
            <if test="jobId != null">
                "job_id" = #{jobId,jdbcType=BIGINT},
            </if>
            <if test="name != null">
                "name" = #{name,jdbcType=VARCHAR},
            </if>
            <if test="type != null">
                type = #{type,jdbcType=SMALLINT},
            </if>
            <if test="status != null">
                status = #{status,jdbcType=SMALLINT},
            </if>
            <if test="index != null">
                index = #{index,jdbcType=INTEGER},
            </if>
            <if test="consumeDataType != null">
                consume_data_type = #{consumeDataType,jdbcType=INTEGER},
            </if>
            <if test="addition != null">
                addition = #{addition,typeHandler=com.sailheader.middleware.common.helper.JsonTypeHandlerPg},
            </if>
            <if test="createdBy != null">
                created_by = #{createdBy,jdbcType=INTEGER},
            </if>
            <if test="createdOn != null">
                created_on = #{createdOn,jdbcType=TIMESTAMP},
            </if>
            <if test="modifiedBy != null">
                modified_by = #{modifiedBy,jdbcType=INTEGER},
            </if>
            <if test="modifiedOn != null">
                modified_on = #{modifiedOn,jdbcType=TIMESTAMP}
            </if>
        </set>
        where id = #{id,jdbcType=BIGINT}
    </update>

    <select id="checkJobIdPresence" parameterType="java.lang.Long" resultType="java.lang.Integer">
        select count(1)
        from "job"
        where id = #{jobId,jdbcType=BIGINT} and status in (1,2);
    </select>

    <update id="reorderActionIndex" parameterType="java.util.List">
        <foreach collection="list" item="item" index="index" open="" close="" separator=";">
            update action_stream
            <set>
                index = #{index}
            </set>
            where id = #{item.id}
        </foreach>
    </update>

    <insert id="insertAction" parameterType="com.sailheader.middleware.model.Action">
        insert into "action_stream"
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">
