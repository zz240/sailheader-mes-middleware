<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sailheader.middleware.action.remote.db.dao.DynamicDataSourceSqlWithJsonDao">

    <insert id="insertAll">
        insert into #{tableName}(#{fieldStr})
        values
        <foreach item='item' index='index' collection='list' open='(' separator=',' close=')'>
            <foreach item='data' index='index' collection='item.entrySet()' separator=','>
                data
            </foreach>
        </foreach>
    </insert>

</mapper>